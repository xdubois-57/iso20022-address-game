# Deny direct web access to this directory.
#
# The application is meant to be served from public/ only. These rules are
# defence in depth for installs whose DocumentRoot is the project root, or
# where mod_rewrite is unavailable and the root .htaccess therefore does nothing.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
