{
    "name": "xdubois-57/iso20022-address-game",
    "description": "Interactive game to learn ISO 20022 postal address structuring",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/xdubois-57/iso20022-address-game",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "~5.8.1",
        "snipe/banbuilder": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "serve": "./scripts/serve.sh",
        "test:coverage": "phpunit --configuration phpunit.xml --coverage-php coverage/php/raw/unit.cov",
        "coverage:merge": "php scripts/merge-coverage.php",
        "analyse": "phpstan analyse --memory-limit=512M",
        "analyse:baseline": "phpstan analyse --memory-limit=512M --generate-baseline=phpstan-baseline.neon"
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    }
}
