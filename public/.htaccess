# ISO 20022 Address Structuring Game
# Route all requests through the front controller

# Security headers for STATIC files.
#
# public/index.php sends a full set, but a request for /assets/... never
# reaches it: the rewrite below deliberately serves existing files directly,
# so every CSS, JS, font and image was answered with no nosniff and no HSTS.
# The passive scan reports that, and is right to — those responses are the
# majority of what a browser fetches from this site.
#
# always, not onsuccess: the default only applies to 2xx, which would leave a
# 304 Not Modified — most of what a returning visitor receives — without them.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Only over HTTPS. RFC 6797 says a browser must ignore this header on a
    # plain connection, and sending it there is noise that suggests a
    # protection that is not in force.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow access to assets directory
    RewriteCond %{REQUEST_URI} ^/assets/ [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route everything else to index.php
    RewriteRule ^ index.php [L]
</IfModule>
