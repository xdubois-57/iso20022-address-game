# Dependencies — anchored to the repository root on purpose.
# Unanchored, `vendor/` also matched public/assets/js/vendor/, which
# silently excluded the bundled address formatter from every clone.
/vendor/

# Config with secrets
config/credentials.php
config/db_config.json

# Deploy script (contains FTP credentials)
deploy.sh

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Storage (cleanup timestamps etc.) — keep the directory's access rules tracked
storage/*
!storage/.htaccess

# Uploaded files
uploads/*.xlsx

# PHPUnit. The glob also catches the "<name> 2.cache" duplicates macOS
# creates when a file is copied while something holds the original.
.phpunit.result*.cache

# Release artifact built by release.sh (attached to the GitHub release, never committed)
release-*.zip

# JavaScript test tooling (package.json — dev-only, see README.md § Running Tests)
node_modules/
coverage/
test-results/
playwright-report/
tests/e2e/.auth/

# OWASP ZAP output from scripts/dast.sh. Never committed: the report describes
# a running instance on a port that existed for one run, and this repository is
# public — see README.md § Dynamic application security testing.
dast-report/
